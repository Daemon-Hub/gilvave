{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gilvave",
  "mainBinaryName": "Gilvave",
  "version": "0.0.1",
  "identifier": "com.gilvave.client",
  "build": {
    "beforeDevCommand": "trunk serve --config ui/Trunk.toml",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "trunk build --release --config ui/Trunk.toml",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Gilvave",
        "width": 800,
        "height": 600,
        "decorations": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
