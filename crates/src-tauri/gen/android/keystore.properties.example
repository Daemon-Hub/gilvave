# Android Keystore configuration for release signing
# Copy this file to keystore.properties in the same directory (crates/src-tauri/gen/android/keystore.properties)
# and fill in your keystore credentials.
#
# Generate a new keystore with:
# keytool -genkeypair -v -keystore gilvave-release.jks -alias gilvave -keyalg RSA -keysize 2048 -validity 10000
#
storeFile=gilvave-release.jks
storePassword=your_keystore_password
keyAlias=gilvave
keyPassword=your_key_password
