{
    "folders": [
        {
            "name": "gilvave",
            "path": ".",
        },
        {
            "name": "📦 CRATES",
            "path": "crates",
        },
        {
            "name": "🎨 PUBLIC-ASSETS",
            "path": "crates/ui/public",
        },
    ],
    "settings": {
        "terminal.integrated.cwd": "${workspaceFolder:gilvave}",
        "terminal.integrated.enablePersistentSessions": true,
        // Исключенные файлы и папки
        "files.exclude": {
            ".vscode": true,
            "target": true,
            "*/**/dist": true,
            "*/**/public": true,
            "*/**/gen": true,
            "*.lock": true,
        },
        // Настройки поиска
        "search.exclude": {
            "/node_modules": true,
            "**/.next": true
        }
    },
    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "Trunk Serve",
                "command": "trunk serve --config ui/Trunk.toml",
                "type": "shell",
                "group": "build"
            }
        ]
    },
    "extensions": {
        "recommendations": [
            "rust-lang.rust-analyzer",
            "dustypomerleau.rust-syntax",
            "tauri-apps.tauri-vscode",
            "tamasfe.even-better-toml",
            "fill-labs.dependi",
            "usernamehw.errorlens",
            "redhat.vscode-yaml"
        ]
    }
}