{
    "folders": [
        {
            "name": "gilvave",
            "path": ".",
        },
        {
            "name": "📦 CRATES",
            "path": "crates",
        },
        {
            "name": "🎨 PUBLIC-ASSETS",
            "path": "crates/ui/public",
        },
    ],
    "settings": {
        "terminal.integrated.cwd": "${workspaceFolder:gilvave}",
        "terminal.integrated.enablePersistentSessions": true,
        // Исключенные файлы и папки
        "files.exclude": {
            ".vscode": true,
            "target": true,
            "*/**/dist": true,
            "*/**/public": true,
            "*.lock": true,
        },
        // Настройки поиска
        "search.exclude": {
            "/node_modules": true,
            "**/.next": true
        }
    },
    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "Trunk Serve",
                "command": "trunk serve --config ui/Trunk.toml",
                "type": "shell",
                "group": "build"
            },
            {
                "label": "Tauri Dev",
                "command": "cargo tauri dev",
                "type": "shell",
                "group": "build"
            },
            {
                "label": "Tauri Build",
                "command": "cargo tauri build",
                "type": "shell",
                "group": "build"
            },
            {
                "label": "Tauri Build for Linux",
                "command": "cargo tauri build --target x86_64-unknown-linux-gnu",
                "type": "shell",
                "group": "build"
            },
            {
                "label": "Tauri Build for Windows",
                "command": "cargo tauri build --target x86_64-pc-windows-gnu",
                "type": "shell",
                "group": "build"
            },
            {
                "label": "Tauri Build for MacOS",
                "command": "cargo tauri build --target x86_64-apple-darwin",
                "type": "shell",
                "group": "build"
            },
            {
                "label": "Tauri Build for Android aarch64",
                "command": "cargo tauri android build --target aarch64 --apk",
                "type": "shell",
                "group": "build"
            },
            {
                "label": "Install Release APK",
                "command": "adb install -r \"${workspaceFolder}\\crates\\src-tauri\\gen\\android\\app\\build\\outputs\\apk\\universal\\release\\app-universal-release.apk\"",
                "type": "shell",
                "group": "build"
            },
            {
                "label": "Install Debug APK",
                "command": "adb install -r \"${workspaceFolder}\\crates\\src-tauri\\gen\\android\\app\\build\\outputs\\apk\\universal\\debug\\app-universal-debug.apk\"",
                "type": "shell",
                "group": "build"
            },
            {
                "label": "Run MSI Installer",
                "command": "${workspaceFolder}\\target\\release\\bundle\\msi\\Gilvave_0.0.1_x64_en-US.msi",
                "type": "shell",
                "group": "build"
            },
            {
                "label": "Run EXE Installer",
                "command": "${workspaceFolder}\\target\\release\\bundle\\exe\\Gilvave_0.0.1_x64_en-US.exe",
                "type": "shell",
                "group": "build"
            },
            {
                "label": "Run DMG Installer",
                "command": "open \"${workspaceFolder}/target/release/bundle/dmg/Gilvave-0.0.1-x64.dmg\"",
                "type": "shell",
                "group": "build"
            }
        ]
    },
    "extensions": {
        "recommendations": [
            "rust-lang.rust-analyzer",
            "dustypomerleau.rust-syntax",
            "tauri-apps.tauri-vscode",
            "tamasfe.even-better-toml",
            "fill-labs.dependi",
            "usernamehw.errorlens",
            "redhat.vscode-yaml"
        ]
    }
}